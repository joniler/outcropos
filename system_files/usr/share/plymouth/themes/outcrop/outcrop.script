# outcrop plymouth theme — talaria ground (#090A09) + warm gold (#C8B46C)
# Logo centered, ring of 8 stepping dots beneath it. The script language has no
# arrays or for-loops, hence the eight fixed dot sprites.

Window.SetBackgroundTopColor (0.035, 0.039, 0.035);
Window.SetBackgroundBottomColor (0.035, 0.039, 0.035);

logo.image = Image ("logo.png");
logo.sprite = Sprite (logo.image);
logo.sprite.SetX (Window.GetWidth () / 2 - logo.image.GetWidth () / 2);
logo.sprite.SetY (Window.GetHeight () / 2 - logo.image.GetHeight () / 2 - 60);

dot.image = Image ("dot.png");
dot.gap = 14;
dot.stride = dot.image.GetWidth () + dot.gap;
dot.start_x = Window.GetWidth () / 2 - 3.5 * dot.stride;
dot.y = Window.GetHeight () / 2 + 90;

dot0 = Sprite (dot.image);
dot0.SetX (dot.start_x);
dot0.SetY (dot.y);
dot1 = Sprite (dot.image);
dot1.SetX (dot.start_x + dot.stride);
dot1.SetY (dot.y);
dot2 = Sprite (dot.image);
dot2.SetX (dot.start_x + 2 * dot.stride);
dot2.SetY (dot.y);
dot3 = Sprite (dot.image);
dot3.SetX (dot.start_x + 3 * dot.stride);
dot3.SetY (dot.y);
dot4 = Sprite (dot.image);
dot4.SetX (dot.start_x + 4 * dot.stride);
dot4.SetY (dot.y);
dot5 = Sprite (dot.image);
dot5.SetX (dot.start_x + 5 * dot.stride);
dot5.SetY (dot.y);
dot6 = Sprite (dot.image);
dot6.SetX (dot.start_x + 6 * dot.stride);
dot6.SetY (dot.y);
dot7 = Sprite (dot.image);
dot7.SetX (dot.start_x + 7 * dot.stride);
dot7.SetY (dot.y);

fun refresh () {
    active = Math.Int (Math.Int (Plymouth.GetTime () / 130) % 8);
    if (active == 0) dot0.SetOpacity (1.0); else dot0.SetOpacity (0.15);
    if (active == 1) dot1.SetOpacity (1.0); else dot1.SetOpacity (0.15);
    if (active == 2) dot2.SetOpacity (1.0); else dot2.SetOpacity (0.15);
    if (active == 3) dot3.SetOpacity (1.0); else dot3.SetOpacity (0.15);
    if (active == 4) dot4.SetOpacity (1.0); else dot4.SetOpacity (0.15);
    if (active == 5) dot5.SetOpacity (1.0); else dot5.SetOpacity (0.15);
    if (active == 6) dot6.SetOpacity (1.0); else dot6.SetOpacity (0.15);
    if (active == 7) dot7.SetOpacity (1.0); else dot7.SetOpacity (0.15);
}

Plymouth.SetRefreshFunction (refresh);
